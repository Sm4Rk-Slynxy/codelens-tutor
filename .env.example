# CodeLens Tutor - Optional Backend Fallback Configuration
# Copy to `.env` for local overrides. Settings saved in the Web UI (localStorage)
# override these defaults per request.

# Default provider mode: "local" or "openrouter"
CODELENS_PROVIDER_MODE=local

# Local Network AI (OpenAI-Compatible: Ollama, vLLM, LM Studio, llama.cpp)
CODELENS_LOCAL_BASE_URL=http://localhost:11434/v1
CODELENS_LOCAL_API_KEY=EMPTY
CODELENS_LOCAL_TEXT_MODEL=qwen2.5-coder:32b
CODELENS_LOCAL_VISION_MODEL=qwen2.5vl:32b
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_SECONDS=600

# OpenRouter API
CODELENS_OPENROUTER_API_KEY=
CODELENS_OPENROUTER_TEXT_MODEL=qwen/qwen-2.5-coder-32b-instruct
CODELENS_OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# Allowed browser CORS origins (JSON array)
CODELENS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
